CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# 关闭 IPv6：DNS 对 open.bigmodel.cn 等国内 API 会返回 IPv6 地址在前，
# 但设备没有 IPv6 全球地址（AUTOCONFIG 关），且 DNS_MAX_HOST_IP=1 只取首个，
# 导致连到不可达的 IPv6 → 20 秒超时。关掉后 DNS 只返回 IPv4，彻底根治。
CONFIG_LWIP_IPV6=n
# 兜底：即使拿到多个 A/AAAA 记录也全保留，让底层能逐个尝试
CONFIG_LWIP_DNS_MAX_HOST_IP=3

# SYN 重传次数 12→4：默认指数退避下 12 次要几十秒，远程丢一个 SYN 就卡满
# 整个 HTTP 超时；降到 4 次约 3 秒内失败，配合上层重试快速恢复。
CONFIG_LWIP_TCP_SYNMAXRTX=4

# ---------------------------------------------------------------------------
# 内部 DRAM 很紧张（LVGL draw buf + WiFi + BT 都要内部 RAM，SDMMC 还要 DMA 内存），
# 下面几项都是为了把内部 DRAM 省出来：
# ---------------------------------------------------------------------------
# 1) NimBLE 主机栈的动态内存改从 PSRAM 分配（默认 INTERNAL），省出几十 KB 内部 DRAM
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# 2) LVGL 内置内存池只要 16KB（这块是 .bss，占内部 RAM）；
#    LV_MEM_POOL_EXPAND_SIZE 只抬高「单池上限 / 最大可分配块」不占内存，
#    看图时解码出来的整帧（320x240 RGB888 约 230KB）需要 >128KB 的块，
#    所以这里给到 256KB
CONFIG_LV_MEM_SIZE_KILOBYTES=16
# 只抬高 TLSF「单池上限」= 1<<log2ceil(LV_MEM_SIZE+EXPAND) = 1MB，本身不占内存。
# 必须够大，否则 lv_mem_add_pool() 挂不上 512KB 的大池，
# 看图时 PNG 解码要的 320x240x4=307KB 连续块就拿不到（画面全黑）。
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=512

# 图片缓存：关着(0)的话每次重绘都要重新解码一遍 SD 卡上的 PNG（几百毫秒）。
# 开着就必须 >= 单张解码结果（320x240 ARGB8888 = 307KB），否则解码器直接返回失败。
CONFIG_LV_CACHE_DEF_SIZE=524288

# 4) 图片/视频解码：BMP、PNG、JPEG(TJPGD) + LVGL 的 POSIX 文件系统
#    （'S' 盘 = /sdcard，于是 lv_image_set_src(img, "S:/a.jpg") 直接读 SD 卡）
CONFIG_LV_USE_BMP=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=83
CONFIG_LV_FS_POSIX_PATH="/sdcard"

# 3) 预留更多内部 RAM 给 DMA / 内部专用分配（SDMMC、WiFi buffer），
#    避免能被 PSRAM 接盘的分配把内部 RAM 吃光
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# ---------------------------------------------------------------------------
# SD 卡中文文件名：FATFS 必须按 UTF-8 给 API，LVGL 才能正常显示中文
# ---------------------------------------------------------------------------
# 默认 ANSI/OEM(CP437) 下，中文长文件名无法转换，会变成 '?' 或直接退回
# 8.3 短名（比如 240X32~1.AVI）。UTF-8 + CP936 才能原样拿到中文。
# 注意：改这项只影响文件名编码，代码里的路径是 ASCII，不受影响。
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE=936
CONFIG_FATFS_CODEPAGE_936=y

# ---------------------------------------------------------------------------
# 拼音输入法：WiFi 密码框/聊天输入框需要打中文。
# LV_USE_IME_PINYIN 开启后 LVGL 自带默认字典（Kconfig 里 USE_DEFAULT_DICT
# 默认 y），不用再单独放字典文件。代码约 40KB、字典在 flash，内部 RAM 占用小。
# ---------------------------------------------------------------------------
CONFIG_LV_USE_IME_PINYIN=y
CONFIG_LV_IME_PINYIN_USE_DEFAULT_DICT=y
CONFIG_LV_IME_PINYIN_CAND_TEXT_NUM=9

# TLS 接收缓冲：4096 太小，智谱等 API 的证书链/TLS 记录超限会报
# -0x87 BAD_INPUT_DATA (PSA_ERROR_INVALID_ARGUMENT)。提到 16384 覆盖大数据响应
# （TTS 下载音频时 TLS 记录较大，8192 仍偶发截断）。
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# 交叉签名证书验证：百度(aip.baidubce.com / tsn.baidu.com)等国内 CDN 用
# cross-signed 证书链，默认 bundle 验签会报 "No matching trusted root certificate found"。
# 开启后仍完整校验链，只是支持交叉签名根，不影响安全性。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# TLS 动态缓冲会让 esp_http_client 每次读出的数据块大小不定(731/264/3537)，
# 配合小 buffer 时大 record 解密触发 -0x0087 (PSA_ERROR_INVALID_ARGUMENT)，
# TTS 下载 MP3 读到几 KB 就断。改用固定大缓冲。
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=n
# esp_http_client 的接收 buffer(16KB)必须是内部 RAM：
# 低于此值的 malloc 走内部 DRAM，避免 TLS 解密目标落在 PSRAM。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32768

# ECDHE 握手的 psa_generate_key 需要内部 RAM。只保留 TLS 实际会用的两种曲线
# (X25519 / SECP256R1)，关掉 521/K1/Brainpool 省下大量定点预计算表占用的 RAM，
# 避免第二次握手时 -0x7F80 (HW_ACCEL_FAILED / psa_generate_key 失败)。
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n

# USB MSC 模拟U盘：USB OTG 用 GPIO19/20，与内置 USB Serial/JTAG 物理冲突，
# 必须关掉 USB Serial/JTAG（调试仍走 UART0 = GPIO43/44）。TinyUSB 用 full-speed OTG。
# secondary console 是 choice，必须选 NONE 才真正关掉 USJ（设 =n 会被默认项顶回）。
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# 关键：这个 driver 项默认 y，不关它的时钟就一直占着 GPIO19/20，
# USB OTG (TinyUSB) 无法使用这两个脚。关闭只影响 app 阶段，bootloader 下载仍可用 USJ。
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
# TinyUSB MSC：SD 卡通过 USB 暴露给电脑，8KB buffer 吞吐更佳（约 0.9MB/s）
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192

# 第三版 S3R8：模组内置 8MB Octal SPI PSRAM（占用 IO33~IO38，含 35/36/37）。
# 必须用 OCT 模式；CLK/CS 仍是 IO30/IO26（ESP32-S3 内部固定）。
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
